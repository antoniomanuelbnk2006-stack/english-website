{
  "name": "senal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "db:types:local": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "studio": "next dev",
    "auth:set-password": "tsx --env-file-if-exists=.env.pipeline scripts/auth/set-password.ts",
    "content:validate": "tsx --env-file-if-exists=.env.pipeline scripts/content/validate.ts",
    "content:annotate": "tsx --env-file-if-exists=.env.pipeline scripts/content/annotate.ts",
    "content:index": "tsx --env-file-if-exists=.env.pipeline scripts/content/build-index.ts",
    "content:tts": "tsx --env-file-if-exists=.env.pipeline scripts/content/tts.ts",
    "content:audio": "tsx --env-file-if-exists=.env.pipeline scripts/content/audio.ts",
    "content:exam-audio": "tsx --env-file-if-exists=.env.pipeline scripts/content/exam-audio.ts",
    "content:upload": "tsx --env-file-if-exists=.env.pipeline scripts/content/upload.ts",
    "content:publish": "tsx --env-file-if-exists=.env.pipeline scripts/content/publish.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@date-fns/tz": "^1.5.0",
    "@mdx-js/mdx": "^3.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "kokoro-js": "1.2.1",
    "microsoft-cognitiveservices-speech-sdk": "^1.52.0",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "packageManager": "pnpm@12.10.1"
}
