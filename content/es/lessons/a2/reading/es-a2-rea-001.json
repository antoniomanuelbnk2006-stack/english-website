  "language_focus": [
    {
      "title_es": {
        "en": "The simple past: fui, comimos, pidió",
        "fr": "Le passé simple : fui, comimos, pidió",
        "zh": "简单过去时：fui, comimos, pidió",
        "ja": "点過去：fui, comimos, pidió"
      },
      "explanation_es": {
