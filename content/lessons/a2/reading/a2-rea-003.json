            { "t": "man", "l": "man", "p": "NOUN", "w": true },
            { "t": "'s", "l": "'s", "p": "PART", "w": false, "sp": true },
            { "t": "jacket", "l": "jacket", "p": "NOUN", "w": true, "sp": true },
            { "t": "and", "l": "and", "p": "CCONJ", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
