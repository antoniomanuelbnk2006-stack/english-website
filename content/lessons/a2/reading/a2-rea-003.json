            { "t": "went", "l": "go", "p": "VERB", "w": true, "sp": true },
            { "t": "to", "l": "to", "p": "ADP", "w": true, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "bus", "l": "bus", "p": "NOUN", "w": true, "sp": true },
            { "t": "stop", "l": "stop", "p": "VERB", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        }
      ]
