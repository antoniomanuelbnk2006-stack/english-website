            { "t": "blue", "l": "blue", "p": "ADJ", "w": true, "sp": true },
            { "t": "bag", "l": "bag", "p": "NOUN", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "and", "l": "and", "p": "CCONJ", "w": true, "sp": true },
            { "t": "it", "l": "it", "p": "PRON", "w": true, "sp": true },
