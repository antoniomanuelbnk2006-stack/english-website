            { "t": "saw", "l": "see", "p": "VERB", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
            { "t": "small", "l": "small", "p": "ADV", "w": true, "sp": true },
            { "t": "blue", "l": "blue", "p": "ADJ", "w": true, "sp": true },
            { "t": "bag", "l": "bag", "p": "NOUN", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
