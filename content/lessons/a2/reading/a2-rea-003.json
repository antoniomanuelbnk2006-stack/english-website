            { "t": "like", "l": "like", "p": "VERB", "w": true, "sp": true },
            { "t": "hers", "l": "hers", "p": "PRON", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
