            { "t": "her", "l": "her", "p": "PRON", "w": true, "sp": true },
            { "t": "where", "l": "where", "p": "ADV", "w": true, "sp": true },
            { "t": "to", "l": "to", "p": "PART", "w": true, "sp": true },
            { "t": "buy", "l": "buy", "p": "VERB", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
            { "t": "bus", "l": "bus", "p": "NOUN", "w": true, "sp": true },
