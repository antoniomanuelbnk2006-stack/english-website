    {
      "id": "p2",
      "sentences": [
        {
          "id": "p2s1",
          "text": "Last spring, my friend Dani and I decided to spend a long weekend in Porto.",
          "tokens": [
            { "t": "Last", "l": "last", "p": "ADJ", "w": true, "sp": true },
            { "t": "spring", "l": "spring", "p": "NOUN", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "my", "l": "my", "p": "PRON", "w": true, "sp": true },
            { "t": "friend", "l": "friend", "p": "NOUN", "w": true, "sp": true },
            { "t": "Dani", "l": "dani", "p": "PROPN", "w": false, "sp": true },
            { "t": "and", "l": "and", "p": "CCONJ", "w": true, "sp": true },
            { "t": "I", "l": "i", "p": "PRON", "w": true, "sp": true },
            { "t": "decided", "l": "decide", "p": "VERB", "w": true, "sp": true },
            { "t": "to", "l": "to", "p": "PART", "w": true, "sp": true },
            { "t": "spend", "l": "spend", "p": "VERB", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
            { "t": "long", "l": "long", "p": "ADJ", "w": true, "sp": true },
            { "t": "weekend", "l": "weekend", "p": "NOUN", "w": true, "sp": true },
            { "t": "in", "l": "in", "p": "ADP", "w": true, "sp": true },
            { "t": "Porto", "l": "porto", "p": "PROPN", "w": false },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p2s2",
          "text": "We had booked a cheap flight for Friday morning, and we had planned every hour of the trip.",
          "tokens": [
            { "t": "We", "l": "we", "p": "PRON", "w": true, "sp": true },
            { "t": "had", "l": "have", "p": "AUX", "w": true, "sp": true },
            { "t": "booked", "l": "book", "p": "VERB", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
            { "t": "cheap", "l": "cheap", "p": "ADJ", "w": true, "sp": true },
            { "t": "flight", "l": "flight", "p": "NOUN", "w": true, "sp": true },
            { "t": "for", "l": "for", "p": "ADP", "w": true, "sp": true },
            { "t": "Friday", "l": "friday", "p": "PROPN", "w": false, "sp": true },
            { "t": "morning", "l": "morning", "p": "NOUN", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "and", "l": "and", "p": "CCONJ", "w": true, "sp": true },
            { "t": "we", "l": "we", "p": "PRON", "w": true, "sp": true },
            { "t": "had", "l": "have", "p": "AUX", "w": true, "sp": true },
            { "t": "planned", "l": "plan", "p": "VERB", "w": true, "sp": true },
            { "t": "every", "l": "every", "p": "DET", "w": true, "sp": true },
            { "t": "hour", "l": "hour", "p": "NOUN", "w": true, "sp": true },
            { "t": "of", "l": "of", "p": "ADP", "w": true, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "trip", "l": "trip", "p": "NOUN", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p2s3",
          "text": "Dani had even made a list of restaurants.",
          "tokens": [
            { "t": "Dani", "l": "dani", "p": "PROPN", "w": false, "sp": true },
            { "t": "had", "l": "have", "p": "AUX", "w": true, "sp": true },
            { "t": "even", "l": "even", "p": "ADV", "w": true, "sp": true },
            { "t": "made", "l": "make", "p": "VERB", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
            { "t": "list", "l": "list", "p": "NOUN", "w": true, "sp": true },
            { "t": "of", "l": "of", "p": "ADP", "w": true, "sp": true },
            { "t": "restaurants", "l": "restaurant", "p": "NOUN", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        }
      ]
    },
    {
      "id": "p3",
      "sentences": [
        {
          "id": "p3s1",
          "text": "The problems started before we left.",
          "tokens": [
            { "t": "The", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "problems", "l": "problem", "p": "NOUN", "w": true, "sp": true },
            { "t": "started", "l": "start", "p": "VERB", "w": true, "sp": true },
            { "t": "before", "l": "before", "p": "ADP", "w": true, "sp": true },
            { "t": "we", "l": "we", "p": "PRON", "w": true, "sp": true },
            { "t": "left", "l": "leave", "p": "VERB", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p3s2",
          "text": "While we were waiting at the gate, the airline announced that our flight had been cancelled because of fog.",
          "tokens": [
            { "t": "While", "l": "while", "p": "SCONJ", "w": true, "sp": true },
            { "t": "we", "l": "we", "p": "PRON", "w": true, "sp": true },
            { "t": "were", "l": "be", "p": "AUX", "w": true, "sp": true },
            { "t": "waiting", "l": "wait", "p": "VERB", "w": true, "sp": true },
            { "t": "at", "l": "at", "p": "ADP", "w": true, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "gate", "l": "gate", "p": "NOUN", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "airline", "l": "airline", "p": "NOUN", "w": true, "sp": true },
            { "t": "announced", "l": "announce", "p": "VERB", "w": true, "sp": true },
            { "t": "that", "l": "that", "p": "SCONJ", "w": true, "sp": true },
            { "t": "our", "l": "our", "p": "PRON", "w": true, "sp": true },
            { "t": "flight", "l": "flight", "p": "NOUN", "w": true, "sp": true },
            { "t": "had", "l": "have", "p": "AUX", "w": true, "sp": true },
            { "t": "been", "l": "be", "p": "AUX", "w": true, "sp": true },
            { "t": "cancelled", "l": "cancel", "p": "VERB", "w": true, "sp": true },
            { "t": "because", "l": "because", "p": "ADP", "w": true, "sp": true },
            { "t": "of", "l": "of", "p": "ADP", "w": true, "sp": true },
            { "t": "fog", "l": "fog", "p": "NOUN", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p3s3",
          "text": "The next one was on Saturday evening, which meant losing half of our holiday.",
          "tokens": [
            { "t": "The", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "next", "l": "next", "p": "ADJ", "w": true, "sp": true },
            { "t": "one", "l": "one", "p": "NUM", "w": false, "sp": true },
            { "t": "was", "l": "be", "p": "AUX", "w": true, "sp": true },
            { "t": "on", "l": "on", "p": "ADP", "w": true, "sp": true },
            { "t": "Saturday", "l": "saturday", "p": "PROPN", "w": false, "sp": true },
            { "t": "evening", "l": "evening", "p": "NOUN", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "which", "l": "which", "p": "PRON", "w": true, "sp": true },
            { "t": "meant", "l": "mean", "p": "VERB", "w": true, "sp": true },
            { "t": "losing", "l": "lose", "p": "VERB", "w": true, "sp": true },
            { "t": "half", "l": "half", "p": "NOUN", "w": true, "sp": true },
            { "t": "of", "l": "of", "p": "ADP", "w": true, "sp": true },
            { "t": "our", "l": "our", "p": "PRON", "w": true, "sp": true },
            { "t": "holiday", "l": "holiday", "p": "NOUN", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p3s4",
          "text": "We were sitting on the floor, feeling miserable, when Dani had an idea.",
          "tokens": [
            { "t": "We", "l": "we", "p": "PRON", "w": true, "sp": true },
            { "t": "were", "l": "be", "p": "AUX", "w": true, "sp": true },
            { "t": "sitting", "l": "sit", "p": "VERB", "w": true, "sp": true },
            { "t": "on", "l": "on", "p": "ADP", "w": true, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "floor", "l": "floor", "p": "NOUN", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "feeling", "l": "feeling", "p": "NOUN", "w": true, "sp": true },
            { "t": "miserable", "l": "miserable", "p": "ADJ", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "when", "l": "when", "p": "ADV", "w": true, "sp": true },
            { "t": "Dani", "l": "dani", "p": "PROPN", "w": false, "sp": true },
            { "t": "had", "l": "have", "p": "AUX", "w": true, "sp": true },
            { "t": "an", "l": "an", "p": "DET", "w": true, "sp": true },
            { "t": "idea", "l": "idea", "p": "NOUN", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p3s5",
          "text": "\"What about the train?\" she said.",
          "tokens": [
            { "t": "\"", "l": "\"", "p": "PUNCT", "w": false },
            { "t": "What", "l": "what", "p": "PRON", "w": true, "sp": true },
            { "t": "about", "l": "about", "p": "ADP", "w": true, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "train", "l": "train", "p": "NOUN", "w": true },
            { "t": "?", "l": "?", "p": "PUNCT", "w": false },
            { "t": "\"", "l": "\"", "p": "PUNCT", "w": false, "sp": true },
            { "t": "she", "l": "she", "p": "PRON", "w": true, "sp": true },
            { "t": "said", "l": "say", "p": "VERB", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        }
      ]
    },
    {
      "id": "p4",
      "sentences": [
        {
          "id": "p4s1",
          "text": "It was not a quick solution.",
          "tokens": [
            { "t": "It", "l": "it", "p": "PRON", "w": true, "sp": true },
            { "t": "was", "l": "be", "p": "AUX", "w": true, "sp": true },
            { "t": "not", "l": "not", "p": "PART", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
            { "t": "quick", "l": "quick", "p": "ADJ", "w": true, "sp": true },
            { "t": "solution", "l": "solution", "p": "NOUN", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p4s2",
          "text": "We took a bus back to the city, bought the last two tickets for a night train and spent eleven hours travelling.",
          "tokens": [
            { "t": "We", "l": "we", "p": "PRON", "w": true, "sp": true },
            { "t": "took", "l": "take", "p": "VERB", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
            { "t": "bus", "l": "bus", "p": "NOUN", "w": true, "sp": true },
            { "t": "back", "l": "back", "p": "ADV", "w": true, "sp": true },
            { "t": "to", "l": "to", "p": "ADP", "w": true, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "city", "l": "city", "p": "NOUN", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "bought", "l": "buy", "p": "VERB", "w": true, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "last", "l": "last", "p": "ADJ", "w": true, "sp": true },
            { "t": "two", "l": "two", "p": "NUM", "w": false, "sp": true },
            { "t": "tickets", "l": "ticket", "p": "NOUN", "w": true, "sp": true },
            { "t": "for", "l": "for", "p": "ADP", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
            { "t": "night", "l": "night", "p": "NOUN", "w": true, "sp": true },
            { "t": "train", "l": "train", "p": "NOUN", "w": true, "sp": true },
            { "t": "and", "l": "and", "p": "CCONJ", "w": true, "sp": true },
            { "t": "spent", "l": "spend", "p": "VERB", "w": true, "sp": true },
            { "t": "eleven", "l": "eleven", "p": "NUM", "w": false, "sp": true },
            { "t": "hours", "l": "hour", "p": "NOUN", "w": true, "sp": true },
            { "t": "travelling", "l": "travel", "p": "VERB", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p4s3",
          "text": "The seats were hard, the heating did not work and neither of us slept much.",
          "tokens": [
            { "t": "The", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "seats", "l": "seat", "p": "NOUN", "w": true, "sp": true },
            { "t": "were", "l": "be", "p": "AUX", "w": true, "sp": true },
            { "t": "hard", "l": "hard", "p": "ADJ", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "heating", "l": "heating", "p": "NOUN", "w": true, "sp": true },
            { "t": "did", "l": "do", "p": "AUX", "w": true, "sp": true },
            { "t": "not", "l": "not", "p": "PART", "w": true, "sp": true },
            { "t": "work", "l": "work", "p": "VERB", "w": true, "sp": true },
            { "t": "and", "l": "and", "p": "CCONJ", "w": true, "sp": true },
            { "t": "neither", "l": "neither", "p": "DET", "w": true, "sp": true },
            { "t": "of", "l": "of", "p": "ADP", "w": true, "sp": true },
            { "t": "us", "l": "us", "p": "PRON", "w": true, "sp": true },
            { "t": "slept", "l": "sleep", "p": "VERB", "w": true, "sp": true },
            { "t": "much", "l": "much", "p": "ADJ", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p4s4",
          "text": "However, something unexpected happened.",
          "tokens": [
            { "t": "However", "l": "however", "p": "ADV", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "something", "l": "something", "p": "PRON", "w": true, "sp": true },
            { "t": "unexpected", "l": "unexpected", "p": "ADJ", "w": true, "sp": true },
            { "t": "happened", "l": "happen", "p": "VERB", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p4s5",
          "text": "We started talking to the family who were sitting opposite us.",
          "tokens": [
            { "t": "We", "l": "we", "p": "PRON", "w": true, "sp": true },
            { "t": "started", "l": "start", "p": "VERB", "w": true, "sp": true },
            { "t": "talking", "l": "talk", "p": "VERB", "w": true, "sp": true },
            { "t": "to", "l": "to", "p": "ADP", "w": true, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "family", "l": "family", "p": "NOUN", "w": true, "sp": true },
            { "t": "who", "l": "who", "p": "PRON", "w": true, "sp": true },
            { "t": "were", "l": "be", "p": "AUX", "w": true, "sp": true },
            { "t": "sitting", "l": "sit", "p": "VERB", "w": true, "sp": true },
            { "t": "opposite", "l": "opposite", "p": "ADJ", "w": true, "sp": true },
            { "t": "us", "l": "us", "p": "PRON", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p4s6",
          "text": "They were from a small town near Porto, and by the time we arrived they had invited us to lunch.",
