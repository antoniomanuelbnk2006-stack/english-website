            { "t": "idea", "l": "idea", "p": "NOUN", "w": true, "sp": true },
            { "t": "is", "l": "be", "p": "AUX", "w": true, "sp": true },
            { "t": "simple", "l": "simple", "p": "ADJ", "w": true },
            { "t": ":", "l": ":", "p": "PUNCT", "w": false, "sp": true },
            { "t": "we", "l": "we", "p": "PRON", "w": true, "sp": true },
            { "t": "learn", "l": "learn", "p": "VERB", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
            { "t": "language", "l": "language", "p": "NOUN", "w": true, "sp": true },
            { "t": "mainly", "l": "mainly", "p": "ADV", "w": true, "sp": true },
            { "t": "when", "l": "when", "p": "ADV", "w": true, "sp": true },
            { "t": "we", "l": "we", "p": "PRON", "w": true, "sp": true },
            { "t": "understand", "l": "understand", "p": "VERB", "w": true, "sp": true },
            { "t": "it", "l": "it", "p": "PRON", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p2s3",
          "text": "In other words, the most useful thing a learner can do is listen and read a lot, as long as the material is not too difficult.",
          "tokens": [
            { "t": "In", "l": "in", "p": "ADP", "w": true, "sp": true },
            { "t": "other", "l": "other", "p": "ADJ", "w": true, "sp": true },
            { "t": "words", "l": "word", "p": "NOUN", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "most", "l": "most", "p": "ADV", "w": true, "sp": true },
            { "t": "useful", "l": "useful", "p": "ADJ", "w": true, "sp": true },
            { "t": "thing", "l": "thing", "p": "NOUN", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
            { "t": "learner", "l": "learner", "p": "NOUN", "w": true, "sp": true },
            { "t": "can", "l": "can", "p": "AUX", "w": true, "sp": true },
            { "t": "do", "l": "do", "p": "AUX", "w": true, "sp": true },
            { "t": "is", "l": "be", "p": "AUX", "w": true, "sp": true },
            { "t": "listen", "l": "listen", "p": "VERB", "w": true, "sp": true },
            { "t": "and", "l": "and", "p": "CCONJ", "w": true, "sp": true },
            { "t": "read", "l": "read", "p": "VERB", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
            { "t": "lot", "l": "lot", "p": "NOUN", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
