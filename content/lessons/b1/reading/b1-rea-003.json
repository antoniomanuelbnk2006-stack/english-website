            { "t": "you", "l": "you", "p": "PRON", "w": true, "sp": true },
            { "t": "understand", "l": "understand", "p": "VERB", "w": true, "sp": true },
            { "t": "everything", "l": "everything", "p": "VERB", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "you", "l": "you", "p": "PRON", "w": true, "sp": true },
            { "t": "will", "l": "will", "p": "AUX", "w": true, "sp": true },
            { "t": "not", "l": "not", "p": "PART", "w": true, "sp": true },
            { "t": "learn", "l": "learn", "p": "VERB", "w": true, "sp": true },
            { "t": "anything", "l": "anything", "p": "PRON", "w": true, "sp": true },
            { "t": "new", "l": "new", "p": "ADJ", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p4s4",
          "text": "Experts suggest looking for texts and recordings in which you understand most of the words but still meet a few new ones.",
          "tokens": [
