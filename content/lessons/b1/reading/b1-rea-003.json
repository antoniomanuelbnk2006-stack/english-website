            { "t": "still", "l": "still", "p": "ADV", "w": true, "sp": true },
            { "t": "find", "l": "find", "p": "VERB", "w": true, "sp": true },
            { "t": "it", "l": "it", "p": "PRON", "w": true, "sp": true },
            { "t": "difficult", "l": "difficult", "p": "ADJ", "w": true, "sp": true },
            { "t": "to", "l": "to", "p": "PART", "w": true, "sp": true },
            { "t": "follow", "l": "follow", "p": "VERB", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
            { "t": "simple", "l": "simple", "p": "ADJ", "w": true, "sp": true },
            { "t": "conversation", "l": "conversation", "p": "NOUN", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p1s4",
          "text": "Is there a better way?",
          "tokens": [
            { "t": "Is", "l": "be", "p": "AUX", "w": true, "sp": true },
            { "t": "there", "l": "there", "p": "PRON", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
            { "t": "better", "l": "good", "p": "ADJ", "w": true, "sp": true },
            { "t": "way", "l": "way", "p": "NOUN", "w": true },
            { "t": "?", "l": "?", "p": "PUNCT", "w": false }
          ]
        }
      ]
    },
    {
      "id": "p2",
      "sentences": [
        {
          "id": "p2s1",
          "text": "More and more teachers believe there is.",
          "tokens": [
            { "t": "More", "l": "more", "p": "ADJ", "w": true, "sp": true },
            { "t": "and", "l": "and", "p": "CCONJ", "w": true, "sp": true },
            { "t": "more", "l": "more", "p": "ADJ", "w": true, "sp": true },
