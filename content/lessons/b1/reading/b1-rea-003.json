            { "t": "believe", "l": "believe", "p": "VERB", "w": true, "sp": true },
            { "t": "there", "l": "there", "p": "PRON", "w": true, "sp": true },
            { "t": "is", "l": "be", "p": "AUX", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p2s2",
          "text": "Their idea is simple: we learn a language mainly when we understand it.",
