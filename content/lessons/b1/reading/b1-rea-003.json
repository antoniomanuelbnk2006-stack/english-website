            { "t": "suggest", "l": "suggest", "p": "VERB", "w": true, "sp": true },
            { "t": "looking", "l": "look", "p": "VERB", "w": true, "sp": true },
            { "t": "for", "l": "for", "p": "ADP", "w": true, "sp": true },
