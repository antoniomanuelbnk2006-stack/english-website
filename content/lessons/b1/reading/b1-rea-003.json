            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p1s2",
          "text": "We studied grammar rules, did exercises and tried to remember lists of words.",
          "tokens": [
            { "t": "We", "l": "we", "p": "PRON", "w": true, "sp": true },
            { "t": "studied", "l": "study", "p": "VERB", "w": true, "sp": true },
            { "t": "grammar", "l": "grammar", "p": "NOUN", "w": true, "sp": true },
            { "t": "rules", "l": "rule", "p": "NOUN", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "did", "l": "do", "p": "AUX", "w": true, "sp": true },
            { "t": "exercises", "l": "exercise", "p": "VERB", "w": true, "sp": true },
            { "t": "and", "l": "and", "p": "CCONJ", "w": true, "sp": true },
            { "t": "tried", "l": "try", "p": "VERB", "w": true, "sp": true },
            { "t": "to", "l": "to", "p": "PART", "w": true, "sp": true },
            { "t": "remember", "l": "remember", "p": "VERB", "w": true, "sp": true },
            { "t": "lists", "l": "list", "p": "NOUN", "w": true, "sp": true },
            { "t": "of", "l": "of", "p": "ADP", "w": true, "sp": true },
            { "t": "words", "l": "word", "p": "NOUN", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p1s3",
          "text": "After years of this, many people still find it difficult to follow a simple conversation.",
