            { "t": "they", "l": "they", "p": "PRON", "w": true, "sp": true },
            { "t": "can", "l": "can", "p": "AUX", "w": true, "sp": true },
            { "t": "choose", "l": "choose", "p": "VERB", "w": true, "sp": true },
            { "t": "what", "l": "what", "p": "PRON", "w": true, "sp": true },
            { "t": "to", "l": "to", "p": "PART", "w": true, "sp": true },
            { "t": "listen", "l": "listen", "p": "VERB", "w": true, "sp": true },
            { "t": "to", "l": "to", "p": "ADP", "w": true },
