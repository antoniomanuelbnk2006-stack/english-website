            { "t": "hear", "l": "hear", "p": "VERB", "w": true, "sp": true },
            { "t": "thousands", "l": "thousand", "p": "NOUN", "w": true, "sp": true },
            { "t": "of", "l": "of", "p": "ADP", "w": true, "sp": true },
            { "t": "hours", "l": "hour", "p": "NOUN", "w": true, "sp": true },
            { "t": "of", "l": "of", "p": "ADP", "w": true, "sp": true },
            { "t": "speech", "l": "speech", "p": "NOUN", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "and", "l": "and", "p": "CCONJ", "w": true, "sp": true },
            { "t": "they", "l": "they", "p": "PRON", "w": true, "sp": true },
            { "t": "slowly", "l": "slowly", "p": "ADV", "w": true, "sp": true },
            { "t": "begin", "l": "begin", "p": "VERB", "w": true, "sp": true },
            { "t": "to", "l": "to", "p": "PART", "w": true, "sp": true },
            { "t": "understand", "l": "understand", "p": "VERB", "w": true, "sp": true },
            { "t": "how", "l": "how", "p": "ADV", "w": true, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "language", "l": "language", "p": "NOUN", "w": true, "sp": true },
            { "t": "works", "l": "work", "p": "VERB", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p3s4",
          "text": "Adults can do something similar, and they have one big advantage: they can choose what to listen to.",
          "tokens": [
            { "t": "Adults", "l": "adult", "p": "ADJ", "w": true, "sp": true },
            { "t": "can", "l": "can", "p": "AUX", "w": true, "sp": true },
            { "t": "do", "l": "do", "p": "AUX", "w": true, "sp": true },
            { "t": "something", "l": "something", "p": "PRON", "w": true, "sp": true },
            { "t": "similar", "l": "similar", "p": "ADJ", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "and", "l": "and", "p": "CCONJ", "w": true, "sp": true },
