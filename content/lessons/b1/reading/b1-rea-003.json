            { "t": "long", "l": "long", "p": "ADJ", "w": true, "sp": true },
            { "t": "as", "l": "as", "p": "ADP", "w": true, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "material", "l": "material", "p": "NOUN", "w": true, "sp": true },
            { "t": "is", "l": "be", "p": "AUX", "w": true, "sp": true },
            { "t": "not", "l": "not", "p": "PART", "w": true, "sp": true },
