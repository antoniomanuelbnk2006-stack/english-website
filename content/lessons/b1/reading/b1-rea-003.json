  "paragraphs": [
    {
      "id": "p1",
      "sentences": [
        {
          "id": "p1s1",
          "text": "Most of us learned languages at school in the same way.",
          "tokens": [
            { "t": "Most", "l": "most", "p": "ADJ", "w": true, "sp": true },
            { "t": "of", "l": "of", "p": "ADP", "w": true, "sp": true },
            { "t": "us", "l": "us", "p": "PRON", "w": true, "sp": true },
            { "t": "learned", "l": "learn", "p": "VERB", "w": true, "sp": true },
            { "t": "languages", "l": "language", "p": "NOUN", "w": true, "sp": true },
            { "t": "at", "l": "at", "p": "ADP", "w": true, "sp": true },
            { "t": "school", "l": "school", "p": "NOUN", "w": true, "sp": true },
            { "t": "in", "l": "in", "p": "ADP", "w": true, "sp": true },
