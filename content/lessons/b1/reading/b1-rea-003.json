    {
      "id": "p3",
      "sentences": [
        {
          "id": "p3s1",
          "text": "This is how children learn their first language.",
          "tokens": [
            { "t": "This", "l": "this", "p": "PRON", "w": true, "sp": true },
            { "t": "is", "l": "be", "p": "AUX", "w": true, "sp": true },
            { "t": "how", "l": "how", "p": "ADV", "w": true, "sp": true },
            { "t": "children", "l": "child", "p": "NOUN", "w": true, "sp": true },
            { "t": "learn", "l": "learn", "p": "VERB", "w": true, "sp": true },
            { "t": "their", "l": "their", "p": "PRON", "w": true, "sp": true },
            { "t": "first", "l": "first", "p": "ADJ", "w": true, "sp": true },
            { "t": "language", "l": "language", "p": "NOUN", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p3s2",
          "text": "Nobody explains the past tense to a three-year-old.",
          "tokens": [
            { "t": "Nobody", "l": "nobody", "p": "PRON", "w": true, "sp": true },
            { "t": "explains", "l": "explain", "p": "VERB", "w": true, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "past", "l": "past", "p": "ADV", "w": true, "sp": true },
            { "t": "tense", "l": "tense", "p": "ADJ", "w": true, "sp": true },
            { "t": "to", "l": "to", "p": "ADP", "w": true, "sp": true },
            { "t": "a", "l": "a", "p": "DET", "w": true, "sp": true },
            { "t": "three", "l": "three", "p": "NUM", "w": false },
            { "t": "-", "l": "-", "p": "PUNCT", "w": false },
            { "t": "year", "l": "year", "p": "NOUN", "w": true },
            { "t": "-", "l": "-", "p": "PUNCT", "w": false },
            { "t": "old", "l": "old", "p": "ADJ", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p3s3",
          "text": "Children hear thousands of hours of speech, and they slowly begin to understand how the language works.",
          "tokens": [
