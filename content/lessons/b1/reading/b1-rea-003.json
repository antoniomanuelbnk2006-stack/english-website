            { "t": "level", "l": "level", "p": "NOUN", "w": true, "sp": true },
            { "t": "of", "l": "of", "p": "ADP", "w": true, "sp": true },
            { "t": "the", "l": "the", "p": "DET", "w": true, "sp": true },
            { "t": "material", "l": "material", "p": "ADJ", "w": true, "sp": true },
            { "t": "matters", "l": "matter", "p": "NOUN", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "though", "l": "though", "p": "SCONJ", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p4s2",
          "text": "If you understand almost nothing, you will soon get bored and give up.",
          "tokens": [
            { "t": "If", "l": "if", "p": "SCONJ", "w": true, "sp": true },
            { "t": "you", "l": "you", "p": "PRON", "w": true, "sp": true },
            { "t": "understand", "l": "understand", "p": "VERB", "w": true, "sp": true },
            { "t": "almost", "l": "almost", "p": "ADV", "w": true, "sp": true },
            { "t": "nothing", "l": "nothing", "p": "PRON", "w": true },
            { "t": ",", "l": ",", "p": "PUNCT", "w": false, "sp": true },
            { "t": "you", "l": "you", "p": "PRON", "w": true, "sp": true },
            { "t": "will", "l": "will", "p": "AUX", "w": true, "sp": true },
            { "t": "soon", "l": "soon", "p": "ADV", "w": true, "sp": true },
            { "t": "get", "l": "get", "p": "VERB", "w": true, "sp": true },
            { "t": "bored", "l": "bore", "p": "VERB", "w": true, "sp": true },
            { "t": "and", "l": "and", "p": "CCONJ", "w": true, "sp": true },
            { "t": "give", "l": "give", "p": "VERB", "w": true, "sp": true },
            { "t": "up", "l": "up", "p": "ADP", "w": true },
            { "t": ".", "l": ".", "p": "PUNCT", "w": false }
          ]
        },
        {
          "id": "p4s3",
          "text": "If you understand everything, you will not learn anything new.",
